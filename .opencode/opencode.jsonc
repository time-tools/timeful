{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "backlog": {
      "type": "local",
      "command": ["backlog", "mcp", "start"],
      "enabled": true,
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true,
    },
  },
}
