# Keep caches and tool state inside the checkout, because DSH's workspace-write
# sandbox mounts $HOME read-only.
#
# XDG_CACHE_HOME must precede `use flake`: the shell it evaluates needs it for
# nix's fetcher locks, and it also relocates the Go build cache that `gala` and
# `go build` use.
export XDG_CACHE_HOME="$PWD/.local/cache"
# Gala extracts its stdlib and keeps its build workspaces under its home dir.
export GALA_HOME="$PWD/.local/gala"
# npm ignores XDG_CACHE_HOME and fails on a read-only ~/.npm; keep installs and
# npx caches here instead.
export npm_config_cache="$PWD/.local/npm-cache"
# codebase-memory-mcp ignores XDG_CACHE_HOME and creates a private cache under
# ~/.cache; point that cache at the checkout too.
export CBM_CACHE_DIR="$PWD/.local/cache/codebase-memory-mcp"

use flake

# Override any BACKLOG_CWD inherited from a shell opened in another workspace,
# so backlog always resolves this repository regardless of the current directory.
export BACKLOG_CWD="$PWD"
