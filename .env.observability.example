# Shared staging and production OpenObserve instance. This file is used only by
# the observability Compose project (compose.observability.yaml).

# Loopback host port for the UI and HTTP API; reach it through an SSH tunnel.
OPENOBSERVE_PORT=5080

# Root user for the shared instance. The password is used only on first start
# and must be a strong secret before the instance is started for the first time.
# OpenObserve requires 8-128 characters with upper and lower case letters, a
# digit, and a special character.
OPENOBSERVE_ROOT_USER_EMAIL=root@timeful.fun
OPENOBSERVE_ROOT_USER_PASSWORD=
