{"nodes": [{"id": "docs_design_architecture_adr_adr_018", "label": "ADR-018: PostgreSQL Is The Single Authoritative Store", "file_type": "document", "source_file": "docs/design/architecture/adr/ADR-018.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_architecture_adr_adr_018_single_authoritative_store", "label": "Single Authoritative Store", "file_type": "rationale", "source_file": "docs/design/architecture/adr/ADR-018.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because it removes cross-store joins, gives every record one authority, and avoids a permanent dual-write path; every record kind must have exactly one authoritative store, every account reference must resolve to one account identity, no mutation may be authored in two stores, no compatibility redirect serves a record from another store, and no record is authored twice."}, {"id": "docs_design_architecture_adr_adr_018_data_ownership_boundary", "label": "PostgreSQL Data Ownership Boundary", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-018.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendar connections, encrypted provider credentials, sub-calendars, calendar preferences, OTP challenges with expiry and lockout semantics, and historical daily user logs are PostgreSQL-owned; event-creator and active-user reporting read PostgreSQL records the system already owns; friend requests are dormant and retired with no replacement table."}], "edges": [{"source": "docs_design_architecture_adr_adr_018", "target": "docs_design_architecture_adr_adr_018_single_authoritative_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-018.md", "source_location": null, "weight": 1.0}, {"sour