{"nodes": [{"id": "docs_design_architecture_adr_adr_004", "label": "ADR-004: Frontend Temporal Runtime Model", "file_type": "document", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_architecture_adr_adr_004_frontend_temporal_runtime_model", "label": "Frontend Temporal Runtime Model", "file_type": "rationale", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temporal-specific regressions came from widening one concept across Temporal, string, and numeric forms, Date leaking into runtime logic, and identity-keyed treatment of Temporal values; a strict runtime model prevents cleanup drift back into mixed representations that obscure boundaries and reintroduce runtime bugs."}, {"id": "docs_design_architecture_adr_adr_004_temporal_value_semantics", "label": "Temporal Value Semantics", "file_type": "rationale", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temporal values are value-keyed domain data, not identity-keyed objects; prefer canonical value-keyed wrappers, .equals(...), or Temporal.*.compare(...) over object identity and relational operators."}, {"id": "docs_design_architecture_adr_adr_004_no_mixed_encoded_and_temporal_unions", "label": "No Mixed Encoded and Temporal Unions", "file_type": "rationale", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One concept is either an encoded boundary form or a Temporal value depending on boundary position; mixed unions such as Temporal | string obscure boundaries and reintroduce runtime bugs, and widening back to unions is a design smell."}, {"id": "docs_design_architecture_adr_adr_004_temporal_polyfill", "label": "temporal-polyfill 1.x", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over @js-temporal/polyfill (52.1 kB vs 19.5 kB min+gzip, dated conformance, no native delegation) because it delegates to native Temporal on Firefox 139+, Chrome 144+, and Node 26+; native and polyfilled implementations are two engines for the same spec."}, {"id": "docs_design_architecture_adr_adr_004_setfaktemporalnow", "label": "setFakeTemporalNow", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_architecture_adr_adr_004", "target": "docs_design_architecture_adr_adr_004_frontend_temporal_runtime_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004", "target": "docs_design_architecture_adr_adr_004_temporal_value_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004", "target": "docs_design_architecture_adr_adr_004_no_mixed_encoded_and_temporal_unions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004", "target": "docs_design_architecture_adr_adr_004_temporal_polyfill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004", "target": "docs_design_architecture_adr_adr_004_setfaktemporalnow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004_frontend_temporal_runtime_model", "target": "docs_design_architecture_adr_adr_004_temporal_polyfill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_004_no_mixed_encoded_and_temporal_unions", "target": "docs_design_architecture_adr_adr_004_temporal_value_semantics", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/design/architecture/adr/ADR-004.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "temporal_runtime_model_rules", "label": "Frontend Temporal Runtime Model Rules", "nodes": ["docs_design_architecture_adr_adr_004", "docs_design_architecture_adr_adr_004_frontend_temporal_runtime_model", "docs_design_architecture_adr_adr_004_temporal_value_semantics", "docs_design_architecture_adr_adr_004_no_mixed_encoded_and_temporal_unions", "docs_design_architecture_adr_adr_004_temporal_polyfill", "docs_design_architecture_adr_adr_004_setfaktemporalnow"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/design/architecture/adr/ADR-004.md"}]}