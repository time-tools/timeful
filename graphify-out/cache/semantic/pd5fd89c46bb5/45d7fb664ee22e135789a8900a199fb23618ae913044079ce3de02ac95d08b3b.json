{"nodes": [{"id": "server_docs_postgres_data_boundaries", "label": "PostgreSQL Data Boundaries", "file_type": "document", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_postgres_data_boundaries_authoritative_store_ownership", "label": "Authoritative Store Ownership", "file_type": "rationale", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every record has exactly one authoritative store and PostgreSQL is that store for every record kind; a record is authoritative in the store that accepts its reads and writes, no other store may be consulted for that record or re-authorize it, no permanent dual write exists, and no compatibility redirect serves a record from another store."}, {"id": "server_docs_postgres_data_boundaries_fresh_identity", "label": "Fresh Identity And Single Authority", "file_type": "rationale", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendar connections, sub-calendars, OTP challenges, and daily user logs each receive fresh identities while the runtime calendar key preserves the email_calendarType map key semantics; platform_identities.id is the sole account identifier with external_user_id removed, OTP challenges grant no account authority, and daily-log membership stays idempotent per account per day."}, {"id": "server_docs_postgres_data_boundaries_credential_encryption_boundary", "label": "Provider Credential Encryption Boundary", "file_type": "rationale", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider credentials are encrypted at rest with authenticated AES-256-GCM using a 32-byte ENCRYPTION_KEY read from the environment, a fresh 96-bit random nonce per encryption, and a versioned 'v1:' envelope of base64(nonce || ciphertext || tag); decryption failures are errors never empty credentials, and no calendar route exposes a token, password, or feed URL."}, {"id": "server_docs_postgres_data_boundaries_otp_one_way_hash", "label": "OTP One-Way Hash Rule", "file_type": "rationale", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTP one-time codes are stored as salted one-way hashes and are not stored with the provider-credential envelope, so the code is not readable at rest; verification compares hashes, at most one challenge is active per email, and the ten-minute expiry and five-attempt lockout are preserved."}, {"id": "server_docs_postgres_data_boundaries_reporting_reads", "label": "Reporting Reads", "file_type": "concept", "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event-creator analytics aggregate postgres_events.creator_posthog_id counting each migrated or new event exactly once, active-user reporting reads daily_user_logs and daily_user_log_members, and signed-up-user reporting reads accounts; reporting reads only PostgreSQL records and copies no reporting data to a second store."}], "edges": [{"source": "server_docs_postgres_data_boundaries", "target": "docs_design_architecture_adr_adr_018", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries", "target": "docs_design_architecture_adr_adr_021", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries", "target": "server_docs_postgres_data_boundaries_authoritative_store_ownership", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries", "target": "server_docs_postgres_data_boundaries_fresh_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries", "target": "server_docs_postgres_data_boundaries_credential_encryption_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries", "target": "server_docs_postgres_data_boundaries_reporting_reads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries_fresh_identity", "target": "server_docs_postgres_data_boundaries_otp_one_way_hash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "server_docs_postgres_data_boundaries_credential_encryption_boundary", "target": "server_docs_postgres_data_boundaries_otp_one_way_hash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/docs/postgres-data-boundaries.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "postgres_single_authority_boundary", "label": "PostgreSQL Single Authority Boundary", "nodes": ["docs_design_architecture_adr_adr_018", "docs_design_architecture_adr_adr_021", "server_docs_postgres_data_boundaries", "docs_design_architecture_adr_adr_018_single_authoritative_store", "docs_design_architecture_adr_adr_021_platform_identity_uuid", "server_docs_postgres_data_boundaries_authoritative_store_ownership"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "server/docs/postgres-data-boundaries.md"}, {"id": "credential_and_otp_protection", "label": "Credential And OTP Protection Boundary", "nodes": ["server_docs_postgres_data_boundaries_credential_encryption_boundary", "server_docs_postgres_data_boundaries_otp_one_way_hash", "server_docs_postgres_data_boundaries_fresh_identity", "docs_design_architecture_adr_adr_018_data_ownership_boundary"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "server/docs/postgres-data-boundaries.md"}]}