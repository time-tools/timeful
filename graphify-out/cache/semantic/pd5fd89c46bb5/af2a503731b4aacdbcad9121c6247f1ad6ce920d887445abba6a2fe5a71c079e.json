{"nodes": [{"id": "docs_design_architecture_adr_adr_020", "label": "ADR-020: Encrypt Provider Credentials At Rest With Authenticated AES-256-GCM", "file_type": "document", "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_architecture_adr_adr_020_aes_256_gcm_encryption_envelope", "label": "AES-256-GCM Credential Encryption Envelope", "file_type": "rationale", "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects tampering, keeps non-secret fields queryable, and gives one versioned boundary (v1: plus base64 of nonce||ciphertext||tag with fresh 96-bit nonce and 128-bit tag) for every provider secret, admitting future key rotation; decryption failure fails closed and never yields an empty credential."}, {"id": "docs_design_architecture_adr_adr_020_encryption_key", "label": "ENCRYPTION_KEY", "file_type": "concept", "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Environment variable read as exactly 32 raw bytes, validated at startup, never logged; a missing or wrong-length key refuses to start, and losing it makes existing credentials unrecoverable."}], "edges": [{"source": "docs_design_architecture_adr_adr_020", "target": "docs_design_architecture_adr_adr_020_aes_256_gcm_encryption_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_020", "target": "docs_design_architecture_adr_adr_020_encryption_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_020_aes_256_gcm_encryption_envelope", "target": "docs_design_architecture_adr_adr_020_encryption_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_020", "target": "docs_design_architecture_adr_adr_015", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_020", "target": "docs_design_architecture_adr_adr_018", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_architecture_adr_adr_020", "target": "docs_requirements_quality_qr_qr_013", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/architecture/adr/ADR-020.md", "source_location": null, "weight": 1.0}], "hyperedges": []}