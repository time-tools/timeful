{"nodes": [{"id": "docs_environments_one_root_env_file_contract", "label": "One Root Env File Per Environment", "file_type": "rationale", "source_file": "docs/environments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The selected root app env file is the single source of truth for Compose interpolation, frontend build args, and backend runtime configuration; Compose has no application-value fallbacks, so every interpolated variable must be declared there."}, {"id": "docs_environments_postgres_role_separation", "label": "PostgreSQL Role Separation", "file_type": "concept", "source_file": "docs/environments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_environments_baseline_migration_strategy", "label": "Baseline Migration Strategy", "file_type": "rationale", "source_file": "docs/environments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "server/migrations starts from a single baseline migration creating the complete current schema on a fresh database; later changes are forward-only incremental Goose migrations that must stay compatible with the prior PostgreSQL-aware server release, and pre-baseline databases are recreated from the baseline rather than upgraded in place."}, {"id": "docs_environments_test_only_provider_overrides", "label": "Test-Only Calendar Provider Overrides", "file_type": "concept", "source_file": "docs/environments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_environments", "label": "Environment Files Contract", "file_type": "document", "source_file": "docs/environments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_environments", "target": "compose", "relati