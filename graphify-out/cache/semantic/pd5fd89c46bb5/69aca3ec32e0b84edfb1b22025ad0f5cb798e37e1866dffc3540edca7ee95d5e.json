{"nodes": [{"id": "docs_design_architecture_readme", "label": "Architecture Decision Records Authoring Guide", "file_type": "document", "source_file": "docs/design/architecture/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_architecture_readme_adr_format", "label": "ADR Format", "file_type": "rationale", "source_file": "docs/design/architecture/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each ADR has a permanent, zero-padded identifier and an ID-only filename, and IDs are assigned sequentially across the repository rather than per component; the format is adapted from MADR 4."}, {"id": "docs_design_architecture_readme_adr_metadata", "label": "ADR Metadata", "file_type": "rationale", "source_file": "docs/design/architecture/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every ADR starts with YAML frontmatter containing id, title, components, status, created_date, and updated_date; the id must match the filename and the H1 is '# <id>: <title>'."}, {"id": "docs_design_architecture_readme_addressed_requirements", "label": "Addressed Requirements Metadata", "file_type": "rationale", "source_file": "docs/design/architecture/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The optional addresses metadata records satisfies, enables, and constrains relations to FRs and QRs; empty relation categories are omitted and incidental contextual references stay in the body rather than becoming generic traceability relations."}, {"id": "docs_design_architecture_readme_untracked_quality_attributes", "label": "Untracked Quality Attributes", "file_type": "rationale", "source_file": "docs/design/architecture/README.md", "source_location": null, "source_url": 