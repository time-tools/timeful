package commands

import (
	"context"
	"encoding/json"
	"net/url"
	"strconv"
	"time"

	"github.com/bwmarrin/discordgo"
	"timeful/server/logger"
	pgstore "timeful/server/postgres"
	"timeful/server/utils"
)

func executeActiveUsers(s *discordgo.Session, m *discordgo.MessageCreate, args []string) {
	var err error

	// Parse args
	var list = false
	var days = 7
	if args.Size() >= 1 {
		if args[0] == "true" {
			list = true
		} else if args[0] == "false" {
			list = false
		} else {
			sendMessage(s, m, s"LIST=${args[0]} is not a valid boolean!")
			return
		}
	}
	if args.Size() >= 2 {
		days, err = strconv.Atoi(args[1])
		if err != nil {
			sendMessage(s, m, s"DAYS=${args[1]} is not a valid number!")
			return
		}
	}

	// Read daily user logs starting from `days` days before the current
	// date from the authoritative PostgreSQL store. Empty days are padded by
	// the repository so the list and chart output are unchanged.
	var startDate = time.Now().AddDate(0, 0, -days)
	startDate = utils.GetDateAtTime(startDate, "00:00:00")

	var repository, repoErr = pgstore.DefaultRepository()
	if repoErr != nil {
		logger.StdErr.Panicln(repoErr)
	}
	var logs, logsErr = repository.ListActiveUserDays(context.Background(), startDate, time.Now())
	if logsErr != nil {
		logger.StdErr.Panicln(logsErr)
	}

	// Define constants
	var dayStrings = activeUsersDayStrings()

	if list {
		// Display a list of all active users
		sendMessage(s, m, "Active Users:\n")
		var message = ""
		for _, log := range logs {
			var date = log.LogDate
			message += dayStrings[date.Weekday()] + " "
			message += utils.GetDateString(date) + " | "
			message += s"Count: ${activeUsersMembersCount(log)}\n"

			for _, user := range log.Members {
				message += s"\t- ${user.FirstName} ${user.LastName} (${user.Email})\n"
			}
		}

		for _, msg := range splitLongMessage(message, "```") {
			sendMessage(s, m, msg)
		}
	} else {
		// Display a bar graph of active users over time

		// Generate labels and data based on logs
		var labels = activeUsersEmptyLabels()
		var data = activeUsersEmptyData()
		for i := activeUsersLogsCount(logs) - 1; i >= 0; i-- {
			labels = activeUsersAppendLabel(labels, utils.GetDateString(logs[i].LogDate))
			data = activeUsersAppendCount(data, activeUsersMembersCount(logs[i]))
		}

		// Generate chart using QuickChart API
		var chart = activeUsersChart(labels, data)
		var jsonStr, _ = json.Marshal(chart)

		var encodedChart = url.PathEscape(string(jsonStr))
		var chartUrl = s"https://quickchart.io/chart?c=$encodedChart&backgroundColor=white"
		var chartEmbed = &discordgo.MessageEmbed{
			Title: "Active Users",
			Image: &discordgo.MessageEmbedImage{
				URL: chartUrl,
			},
		}

		sendEmbed(s, m, chartEmbed)
	}
}

var activeUsers Command = Command{
	Name: "!active_users",
	Description: `Gets the number of active users in the database, based on last sign in date. 
  - if LIST is true, it will list the name/email of all users, otherwise, it will show a bar graph
  - DAYS is the amount of days since last sign in
  `,
	Usage:   "!active_users [LIST=false] [DAYS=7]",
	Execute: executeActiveUsers,
}
