package commands

import (
	"context"
	"encoding/json"
	"net/url"
	"strconv"
	"time"

	"github.com/bwmarrin/discordgo"
	"timeful/server/logger"
	"timeful/server/postgres"
	"timeful/server/utils"
)

import "martianoff/gala/go_interop"

func executeActiveUsers(s Ptr[discordgo.Session], m Ptr[discordgo.MessageCreate], args []string) {
	// Parse args
	var list = false
	var days = 7
	if args.Size() >= 1 {
		if args[0] == "true" {
			list = true
		} else if args[0] == "false" {
			list = false
		} else {
			sendMessage(s, m, s"LIST=${args[0]} is not a valid boolean!")
			return
		}
	}
	if args.Size() >= 2 {
		strconv.Atoi(args[1]) match {
			case Success(parsed) => days = parsed
			case Failure(_) => {
				sendMessage(s, m, s"DAYS=${args[1]} is not a valid number!")
				return
			}
		}
	}

	// Read daily user logs starting from `days` days before the current
	// date from the authoritative PostgreSQL store. Empty days are padded by
	// the repository so the list and chart output are unchanged.
	val startDate = utils.GetDateAtTime(time.Now().AddDate(0, 0, -days), "00:00:00")

	val repository = postgres.DefaultRepository().OnFailure((err) => logger.StdErr.Panicln(err)).Get()
	val logs = repository.ListActiveUserDays(context.Background(), startDate, time.Now()).OnFailure((err) => logger.StdErr.Panicln(err)).Get()

	// Define constants
	val dayStrings = activeUsersDayStrings()

	if list {
		// Display a list of all active users
		sendMessage(s, m, "Active Users:\n")
		var message = ""
		for _, log := range logs {
			val date = log.LogDate
			message += dayStrings[date.Weekday()] + " "
			message += utils.GetDateString(date) + " | "
			message += s"Count: ${activeUsersMembersCount(log)}\n"

			for _, user := range log.Members {
				message += s"\t- ${user.FirstName} ${user.LastName} (${user.Email})\n"
			}
		}

		for _, msg := range splitLongMessage(message, "```") {
			sendMessage(s, m, msg)
		}
	} else {
		// Display a bar graph of active users over time

		// Generate labels and data based on logs
		var labels = activeUsersEmptyLabels()
		var data = activeUsersEmptyData()
		for i := activeUsersLogsCount(logs) - 1; i >= 0; i-- {
			labels = activeUsersAppendLabel(labels, utils.GetDateString(logs[i].LogDate))
			data = activeUsersAppendCount(data, activeUsersMembersCount(logs[i]))
		}

		// Generate chart using QuickChart API
		val chart = activeUsersChart(labels, data)
		val jsonStr, _ = json.Marshal(chart)

		val encodedChart = url.PathEscape(string(jsonStr))
		val chartUrl = s"https://quickchart.io/chart?c=$encodedChart&backgroundColor=white"
		val chartEmbed = &discordgo.MessageEmbed{
			Title: "Active Users",
			Image: &discordgo.MessageEmbedImage{
				URL: chartUrl,
			},
		}

		sendEmbed(s, m, chartEmbed)
	}
}

var activeUsers Command = Command{
	Name: "!active_users",
	Description: `Gets the number of active users in the database, based on last sign in date. 
  - if LIST is true, it will list the name/email of all users, otherwise, it will show a bar graph
  - DAYS is the amount of days since last sign in
  `,
	Usage:   "!active_users [LIST=false] [DAYS=7]",
	Execute: executeActiveUsers,
}

func activeUsersDayStrings() []string = go_interop.SliceOf("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

func activeUsersEmptyLabels() []string = go_interop.SliceWithSize[string](0)

func activeUsersEmptyData() []int = go_interop.SliceWithSize[int](0)

func activeUsersAppendLabel(labels []string, label string) []string = go_interop.SliceAppend(labels, label)

func activeUsersAppendCount(data []int, count int) []int = go_interop.SliceAppend(data, count)

func activeUsersLogsCount(logs []postgres.DailyUserLog) int = logs.Size()

func activeUsersMembersCount(log postgres.DailyUserLog) int = log.Members.Size()

func activeUsersChart(labels []string, data []int) map[string]any {
	var chart = go_interop.MapEmpty[string, any]()
	chart["type"] = "bar"
	var chartData = go_interop.MapEmpty[string, any]()
	chartData["labels"] = labels
	var dataset = go_interop.MapEmpty[string, any]()
	dataset["label"] = "Active Users"
	dataset["data"] = data
	chartData["datasets"] = go_interop.SliceOf[any](dataset)
	chart["data"] = chartData
	var options = go_interop.MapEmpty[string, any]()
	var scales = go_interop.MapEmpty[string, any]()
	var yAxis = go_interop.MapEmpty[string, any]()
	var ticks = go_interop.MapEmpty[string, any]()
	ticks["stepSize"] = 1
	yAxis["ticks"] = ticks
	scales["yAxes"] = go_interop.SliceOf[any](yAxis)
	options["scales"] = scales
	chart["options"] = options
	return chart
}
