package commands

import "github.com/bwmarrin/discordgo"

func executeHelp(s Ptr[discordgo.Session], m Ptr[discordgo.MessageCreate], args []string) {
	var message string
	for _, command := range Commands {
		message += s"\n\n`${command.Name}`: ${command.Description} "
		if (command.Usage != "") {
			message += s"Usage: `${command.Usage}`"
		}
	}

	sendMessage(s, m, message)
}

var help Command = Command{
	Name:        "!help",
	Description: "Displays this help message",
	Execute:     executeHelp,
}
