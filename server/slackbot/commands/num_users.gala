package commands

import (
	"context"

	"timeful/server/logger"
	pgstore "timeful/server/postgres"
)

func executeNumUsers(args []string, webhookUrl string) {
	var repository, err = pgstore.DefaultRepository()
	if err != nil {
		logger.StdErr.Panicln(err)
	}
	var n, countErr = repository.CountAccounts(context.Background())
	if countErr != nil {
		logger.StdErr.Panicln(countErr)
	}

	SendRawMessage(newResponse("in_channel", s"Number of currently signed up users: $n"), webhookUrl)
}

var numUsers Command = Command{
	Name:        "/num_users",
	Description: "Returns the number of signed up users",
	Execute:     executeNumUsers,
}
