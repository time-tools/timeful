package main

import (
	"context"
	"mime"
	"net/http"
	"os"
	"path/filepath"
	"time"
	"github.com/gin-gonic/gin"
	"timeful/server/appenv"
	"timeful/server/logger"
	"timeful/server/postgres"
	"timeful/server/utils"
)

import "martianoff/gala/resource"

var defaultLogPath = "logs/server.log"

var postgresPing func(context.Context) error = postgres.Ping

// @title Timeful API
// @version 1.0
// @description This is the API for Timeful.
// @host localhost:3002/api
func init() {
	mime.AddExtensionType(".css", "text/css")
	mime.AddExtensionType(".js", "application/javascript")
	mime.AddExtensionType(".svg", "image/svg+xml")
	mime.AddExtensionType(".woff", "font/woff")
	mime.AddExtensionType(".woff2", "font/woff2")
	mime.AddExtensionType(".ttf", "font/ttf")
	mime.AddExtensionType(".json", "application/json")
	mime.AddExtensionType(".map", "application/json")
}

func initHealthRoute(apiRouter *gin.RouterGroup) {
	apiRouter.GET("/health/live", (c *gin.Context) => {
		c.JSON(http.StatusOK, gin.H{"status": "ok"})
	})

	apiRouter.GET("/health", (c *gin.Context) => {
		var ctx, cancel = context.WithTimeout(c.Request.Context(), 2*time.Second)
		resource.Bracket(cancel, (cancelFn) => cancelFn(), (_) => {
			var pingErr = postgresPing(ctx)
			if (pingErr != nil) {
				c.JSON(http.StatusServiceUnavailable, gin.H{"status": "unavailable"})
				return true
			}

			c.JSON(http.StatusOK, gin.H{"status": "ok"})
			return true
		})
	})
}

func shouldRunInReleaseMode(env appenv.Environment) bool = appenv.ShouldUseReleaseMode(os.Getenv("GIN_MODE"), env)

func openLogFile(path string) (*os.File, error) {
	val logDir = filepath.Dir(path)
	if (logDir != ".") {
		var mkdirErr = os.MkdirAll(logDir, 0755)
		if (mkdirErr != nil) {
			return Failure(mkdirErr)
		}
	}

	var logFile, openErr = os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if (openErr != nil) {
		return Failure(openErr)
	}
	return Success(logFile)
}

// configureRuntime validates Compose-injected configuration before startup.
func configureRuntime() appenv.Environment {
	val currentAppEnv = appenv.Current()

	validateSessionSecret()
	var validateErr = utils.ValidateBaseUrl()
	if (validateErr != nil) {
		logger.StdErr.Panicln(validateErr)
	}

	return currentAppEnv
}

// validateSessionSecret ensures SESSION_SECRET is set and meets security requirements
func validateSessionSecret() {
	val secret = os.Getenv("SESSION_SECRET")

	if (secret == "") {
		logger.StdErr.Panicln("SESSION_SECRET environment variable is required but not set")
	}

	if (secret.ByteSize() < 32) {
		logger.StdErr.Panicln("SESSION_SECRET must be at least 32 characters long")
	}
}

func eventPageHandler(hasFrontendIndex bool) gin.HandlerFunc = (c) => {
	if (!hasFrontendIndex) {
		c.JSON(http.StatusNotFound, gin.H{"error": "route not found"})
		return
	}

	c.HTML(http.StatusOK, "index.html", gin.H{})
}

func noRouteHandler() gin.HandlerFunc = (c) => {
	c.JSON(http.StatusNotFound, gin.H{"error": "route not found"})
}
