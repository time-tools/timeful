package postgres

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"encoding/base64"
	"errors"
	"fmt"
	"os"
	"strings"

	"martianoff/gala/go_interop"
)

var encryptionKeyEnvironment = "ENCRYPTION_KEY"

var encryptionKeyLength = 32

var credentialEnvelopeVersion = "v1:"

// ErrEncryptionKeyUnavailable reports a missing or wrong-length ENCRYPTION_KEY.
// The codec refuses to derive a key, so provider credentials fail closed rather
// than being written or read under an unexpected construction.
var ErrEncryptionKeyUnavailable = errors.New("ENCRYPTION_KEY must be exactly 32 raw bytes")

// credentialCodec encrypts provider secrets with authenticated AES-256-GCM. The
// stored envelope is the version prefix followed by the base64 encoding of
// nonce || ciphertext || tag, so a future key or algorithm change is
// distinguishable without ambiguity.
struct credentialCodec(var aead cipher.AEAD)

func newCredentialCodec(key []byte) (*credentialCodec, error) {
	if (key.Size() != encryptionKeyLength) {
		return Failure(ErrEncryptionKeyUnavailable)
	}
	var block, cipherErr = aes.NewCipher(key)
	if (cipherErr != nil) {
		return Failure(fmt.Errorf("initialize credential cipher: %w", cipherErr))
	}
	var aead, aeadErr = cipher.NewGCM(block)
	if (aeadErr != nil) {
		return Failure(fmt.Errorf("initialize credential AEAD: %w", aeadErr))
	}
	return Success(&credentialCodec{aead: aead})
}

func credentialCodecFromEnvironment() (*credentialCodec, error) {
	return newCredentialCodec(go_interop.ToBytes(os.Getenv(encryptionKeyEnvironment)))
}

// ValidateCredentialEncryptionKey reports whether ENCRYPTION_KEY is usable by
// the credential codec. Startup wiring calls it so a missing or wrong-length
// key refuses to serve rather than silently degrading credential storage.
func ValidateCredentialEncryptionKey() error {
	var _, err = credentialCodecFromEnvironment()
	return err
}

func (c Ptr[credentialCodec]) encrypt(plaintext string) (string, error) {
	var nonce = go_interop.SliceWithSize[byte](c.aead.NonceSize())
	var _, readErr = rand.Read(nonce)
	if (readErr != nil) {
		return Failure(fmt.Errorf("generate credential nonce: %w", readErr))
	}
	var ciphertext = c.aead.Seal(nil, nonce, go_interop.ToBytes(plaintext), nil)
	var payload = go_interop.SliceWithCapacity[byte](nonce.Size() + ciphertext.Size())
	payload = go_interop.SliceAppendAll(payload, nonce)
	payload = go_interop.SliceAppendAll(payload, ciphertext)
	return Success(credentialEnvelopeVersion + base64.StdEncoding.EncodeToString(payload))
}

// decrypt rejects an unrecognized envelope, a truncated payload, and any
// authentication failure instead of returning a partial or empty credential.
func (c Ptr[credentialCodec]) decrypt(envelope string) (string, error) {
	if (!strings.HasPrefix(envelope, credentialEnvelopeVersion)) {
		return Failure(errors.New("credential envelope version is not supported"))
	}
	var payload, decodeErr = base64.StdEncoding.DecodeString(strings.TrimPrefix(envelope, credentialEnvelopeVersion))
	if (decodeErr != nil) {
		return Failure(fmt.Errorf("decode credential envelope: %w", decodeErr))
	}
	var nonceSize = c.aead.NonceSize()
	if (payload.Size() < nonceSize) {
		return Failure(errors.New("credential envelope is truncated"))
	}
	var plaintext, openErr = c.aead.Open(nil, go_interop.SliceTake(payload, nonceSize), go_interop.SliceDrop(payload, nonceSize), nil)
	if (openErr != nil) {
		return Failure(fmt.Errorf("decrypt credential: %w", openErr))
	}
	return Success(string(plaintext))
}
