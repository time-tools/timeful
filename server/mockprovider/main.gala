// Command mockprovider is a test-only HTTP server that stands in for the
// external OAuth and calendar providers in the isolated Compose test stack.
//
// It is intentionally registered only in compose.test.yaml, shareable with the
// server-test container over the test network, and never part of production
// Compose. The server reaches it through the TEST_-prefixed provider endpoint
// overrides documented in docs/environments.md.
package main

import (
	"encoding/base64"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"strings"
	"sync/atomic"
)

import "martianoff/gala/go_interop"

var defaultPort = "8099"

var mockEmail = "calendar-mock@example.invalid"

var accessTokenTTL = 3600

var tokenSequence atomic.Int64

func main() {
	var port = strings.TrimSpace(os.Getenv("MOCK_PROVIDER_PORT"))
	if (port == "") {
		port = defaultPort
	}

	var mux = http.NewServeMux()
	var healthBody = go_interop.MapEmpty[string, string]()
	go_interop.MapPut[string, string](healthBody, "status", "ok")
	mux.HandleFunc("/health", requireMethod(http.MethodGet, writeJSON(healthBody)))
	mux.HandleFunc("/google/token", requireMethod(http.MethodPost, handleToken))
	mux.HandleFunc("/microsoft/token", requireMethod(http.MethodPost, handleToken))
	mux.HandleFunc("/google/calendar/v3/users/me/calendarList", requireMethod(http.MethodGet, handleGoogleCalendarList))
	mux.HandleFunc("/google/calendar/v3/calendars/", requireMethod(http.MethodGet, handleEmptyGoogleEvents))
	mux.HandleFunc("/microsoft/graph/v1.0/me", requireMethod(http.MethodGet, handleMicrosoftUserInfo))
	mux.HandleFunc("/microsoft/graph/v1.0/me/calendars", requireMethod(http.MethodGet, handleMicrosoftCalendarList))
	mux.HandleFunc("/microsoft/graph/v1.0/me/calendars/", requireMethod(http.MethodGet, handleEmptyMicrosoftEvents))

	var address = ":" + port
	log.Printf("mock provider listening on %s", address)
	var listenErr = http.ListenAndServe(address, mux)
	if (listenErr != nil) {
		log.Fatalf("mock provider server failed: %v", listenErr)
	}
}

func requireMethod(method string, handler http.HandlerFunc) http.HandlerFunc {
	return (w http.ResponseWriter, r Ptr[http.Request]) => {
		if (r.Method != method) {
			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
			return
		}
		handler(w, r)
	}
}

func writeJSON(body any) http.HandlerFunc {
	return (w http.ResponseWriter, r Ptr[http.Request]) => {
		w.Header().Set("Content-Type", "application/json")
		var encodeErr = json.NewEncoder(w).Encode(body)
		if (encodeErr != nil) {
			log.Printf("mock provider encode response: %v", encodeErr)
		}
	}
}

// handleToken serves both the Google and Microsoft token exchange. It returns a
// monotonically increasing access token so a refresh persists an observably new
// value, and a valid three-part id_token so the Google add-account path can read
// the provider email without signature verification.
func handleToken(w http.ResponseWriter, r Ptr[http.Request]) {
	var parseErr = r.ParseForm()
	if (parseErr != nil) {
		http.Error(w, "invalid form", http.StatusBadRequest)
		return
	}

	var accessToken = fmt.Sprintf("mock-access-token-%d", tokenSequence.Add(1))
	var response = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](response, "access_token", accessToken)
	go_interop.MapPut[string, any](response, "expires_in", accessTokenTTL)
	go_interop.MapPut[string, any](response, "token_type", "Bearer")
	go_interop.MapPut[string, any](response, "scope", "openid email https://www.googleapis.com/auth/calendar")

	if (r.FormValue("grant_type") != "refresh_token") {
		go_interop.MapPut[string, any](response, "refresh_token", "mock-refresh-token")
		go_interop.MapPut[string, any](response, "id_token", mockIDToken())
	}

	writeJSON(response)(w, r)
}

func handleGoogleCalendarList(w http.ResponseWriter, r Ptr[http.Request]) {
	var primary = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](primary, "id", "primary")
	go_interop.MapPut[string, any](primary, "summary", "Primary")
	go_interop.MapPut[string, any](primary, "selected", true)
	var work = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](work, "id", "work")
	go_interop.MapPut[string, any](work, "summary", "Work")
	go_interop.MapPut[string, any](work, "selected", false)
	var items = go_interop.SliceOf(primary, work)
	var body = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](body, "items", items)
	writeJSON(body)(w, r)
}

func handleEmptyGoogleEvents(w http.ResponseWriter, r Ptr[http.Request]) {
	var body = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](body, "items", go_interop.SliceEmpty[any]())
	writeJSON(body)(w, r)
}

func handleMicrosoftUserInfo(w http.ResponseWriter, r Ptr[http.Request]) {
	var body = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](body, "givenName", "Mock")
	go_interop.MapPut[string, any](body, "surname", "Calendar")
	go_interop.MapPut[string, any](body, "mail", mockEmail)
	writeJSON(body)(w, r)
}

func handleMicrosoftCalendarList(w http.ResponseWriter, r Ptr[http.Request]) {
	var primary = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](primary, "id", "primary")
	go_interop.MapPut[string, any](primary, "name", "Primary")
	var work = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](work, "id", "work")
	go_interop.MapPut[string, any](work, "name", "Work")
	var body = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](body, "value", go_interop.SliceOf(primary, work))
	writeJSON(body)(w, r)
}

func handleEmptyMicrosoftEvents(w http.ResponseWriter, r Ptr[http.Request]) {
	var body = go_interop.MapEmpty[string, any]()
	go_interop.MapPut[string, any](body, "value", go_interop.SliceEmpty[any]())
	writeJSON(body)(w, r)
}

// mockIDToken builds an unsigned three-part token accepted by the server's
// sjwt.Parse, carrying only the provider email the add-calendar path reads.
func mockIDToken() string {
	var headerClaims = go_interop.MapEmpty[string, string]()
	go_interop.MapPut[string, string](headerClaims, "typ", "JWT")
	go_interop.MapPut[string, string](headerClaims, "alg", "none")
	var header, headerErr = json.Marshal(headerClaims)
	var emailClaims = go_interop.MapEmpty[string, string]()
	go_interop.MapPut[string, string](emailClaims, "email", mockEmail)
	var claims, claimsErr = json.Marshal(emailClaims)
	_ = headerErr
	_ = claimsErr
	return fmt.Sprintf(
		"%s.%s.signature",
		base64.RawURLEncoding.EncodeToString(header),
		base64.RawURLEncoding.EncodeToString(claims),
	)
}
