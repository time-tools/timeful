package routes

import (
	"timeful/server/models"
	"timeful/server/respondents"
)

func cloneUser(user Ptr[models.User]) Ptr[models.User] {
	var clone = *user
	return &clone
}

func sanitizedResponseUser(user Ptr[models.User]) Ptr[models.User] {
	val sanitized = cloneUser(user)
	val firstName, lastName, _ = respondents.SanitizeUserDisplayName(sanitized)
	sanitized.FirstName = firstName
	sanitized.LastName = lastName

	return sanitized
}

func canonicalGuestName(name string) string {
	val validation = respondents.ValidateGuestName(name)
	return if (validation.Code != respondents.GuestNameValid) { "" } else { validation.Name }
}

func guestNameValidationErrorMessage(code respondents.GuestNameValidationCode) string = code match {
	case respondents.GuestNameRequired => "Guest name is required"
	case respondents.GuestNameInvalidFormatting => "Guest name contains only unsupported formatting characters"
	case respondents.GuestNameAccountIDLike => "Guest name cannot look like an account ID"
	case respondents.GuestNameTooLong => "Guest name must be 100 characters or fewer"
	case _ => "Guest name is invalid"
}

// populateSignUpResponsePayloadIdentity resolves the response identity key and
// promotes the live account profile when one exists. liveUsers carries the
// batched account read keyed by platform identity UUID; a missing account
// (including a failed batch read) falls back to the stored response identity so
// the wire shape never gains an account shape it did not have before.
func populateSignUpResponsePayloadIdentity(response *models.SignUpResponse, liveUsers map[string]*models.User) (string, bool) {
	if (OptionPtrOf(response).IsEmpty()) {
		return ("", false)
	}

	if !response.UserId.IsZero() {
		val lookupKey = response.UserId.String()
		OptionPtrOf(liveUsers[lookupKey]) match {
			case Some(liveUser) => response.User = sanitizedResponseUser(liveUser)
			case None() => {
				val fallbackName = respondents.NormalizeGuestName(response.Name)
				response.User = &models.User{
					Id:        response.UserId,
					FirstName: fallbackName,
					Email:     response.Email,
				}
			}
		}
		return (lookupKey, true)
	}

	val name = canonicalGuestName(response.Name)
	if (name == "") {
		return ("", false)
	}

	response.Name = name
	response.User = &models.User{
		FirstName: name,
		Email:     response.Email,
	}
	return (name, true)
}
