package routes

import (
	"context"
	"crypto/rand"
	"crypto/subtle"
	"encoding/base64"
	"errors"
	"net/http"
	"strings"

	"github.com/gin-contrib/sessions"
	"github.com/gin-gonic/gin"
	"github.com/jackc/pgx/v5"
	"timeful/server/errs"
	pgstore "timeful/server/postgres"
)

import "martianoff/gala/go_interop"

func ownerCookieName(eventID string) string = "timeful_owner_" + eventID

func issueOwnerToken(ctx context.Context, repo *pgstore.Repository, event *pgstore.Event) (string, error) {
	var secret = go_interop.SliceWithSize[byte](32)
	var _, readErr = rand.Read(secret)
	if (readErr != nil) {
		return Failure(readErr)
	}
	var token = base64.RawURLEncoding.EncodeToString(secret)
	var setErr = repo.SetEventOwnerToken(ctx, event.ID, hashBytes(token))
	if (setErr != nil) {
		return Failure(setErr)
	}
	return Success(token)
}

func setOwnerCookie(c Ptr[gin.Context], eventID string, token string) {
	http.SetCookie(c.Writer, &http.Cookie{
		Name:     ownerCookieName(eventID),
		Value:    token,
		Path:     "/api",
		MaxAge:   34560000,
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
		Secure:   c.Request.TLS != nil || c.GetHeader("X-Forwarded-Proto") == "https",
	})
}

// authorizeOwner runs under the event row lock, serializing takeover
// with protected mutations. Token proof never changes response ownership.
func authorizeOwner(c Ptr[gin.Context], repo *pgstore.Repository, event *pgstore.Event) (bool, error) {
	if (event.IsDeleted) {
		return Failure(pgx.ErrNoRows)
	}
	var ctx = c.Request.Context()
	var sessionValue = sessions.Default(c).Get("userId")
	var platformIdentityID = sessionValue match {
		case id: string => id
		case _ => ""
	}
	var token, tokenErr = c.Cookie(ownerCookieName(event.ShortID))
	if (tokenErr == nil && token != "" && subtle.ConstantTimeCompare(hashBytes(token), event.OwnerEditTokenHash) == 1) {
		if (platformIdentityID != "") {
			var platform, platformErr = resolveSessionPlatformIdentity(ctx, repo, platformIdentityID)
			if (platformErr != nil) {
				return Failure(platformErr)
			}
			if (platform != nil && (event.OwnerPlatformIdentityID == nil || *event.OwnerPlatformIdentityID != platform.ID)) {
				var associateErr = repo.AssociateEventOwner(ctx, event.ID, platform.ID)
				if (associateErr != nil) {
					return Failure(associateErr)
				}
				event.OwnerPlatformIdentityID = &platform.ID
			}
		}
		return Success(true)
	}
	if (platformIdentityID != "") {
		var owned, ownedErr = repo.EventOwnerBelongsToAccount(ctx, event.ID, platformIdentityID)
		if (ownedErr != nil) {
			return Failure(ownedErr)
		}
		if (owned) {
			return Success(true)
		}
	}
	var grantVisitor, grant, grantErr = provenGrant(c, repo, event)
	if (grantErr != nil) {
		return Failure(grantErr)
	}
	if (grant != nil && grant.GrantsOwner && event.OwnerEventVisitorIdentityID != nil && grantVisitor.ID == *event.OwnerEventVisitorIdentityID) {
		return Success(true)
	}
	// Retain validation of grants stored in the foundation cookie slot.
	// A base EVCC, even the creator's, never grants Event Owner powers.
	var cookie, cookieErr = c.Cookie(credentialCookieName(event.ShortID))
	if (cookieErr != nil) {
		return Success(false)
	}
	var parts = strings.Split(cookie, ".")
	if (parts.Size() != 3) {
		return Success(false)
	}
	var visitor, visitorErr = repo.GetEventVisitorIdentity(ctx, event.ID, parts[0])
	if (errors.Is(visitorErr, pgx.ErrNoRows)) {
		return Success(false)
	}
	if (visitorErr != nil) {
		return Failure(visitorErr)
	}
	var credential, credentialErr = provenCredential(c, repo, visitor, event.ShortID)
	if (credentialErr != nil) {
		return Failure(credentialErr)
	}
	var allowed = credential != nil && credential.Kind == pgstore.CredentialKindGranted && credential.GrantsOwner && event.OwnerEventVisitorIdentityID != nil && visitor.ID == *event.OwnerEventVisitorIdentityID
	return Success(allowed)
}

func resolveOwner(c Ptr[gin.Context], repo *pgstore.Repository, event *pgstore.Event) (bool, error) {
	var authorized = false
	var runErr = repo.WithTransaction(c.Request.Context(), (ctx context.Context, tx *pgstore.Repository) => {
		var locked, lockErr = tx.LockEvent(ctx, event.ID)
		if (lockErr != nil) {
			return lockErr
		}
		var newAuthorized, authErr = authorizeOwner(c, tx, locked)
		if (authErr != nil) {
			return authErr
		}
		authorized = newAuthorized
		replaceEvent(event, locked)
		return nil
	})
	if (runErr != nil) {
		return Failure(runErr)
	}
	return Success(authorized)
}

func writableEvent(event *pgstore.Event) error {
	if (event.IsDeleted) {
		return pgx.ErrNoRows
	}
	if (event.IsArchived) {
		return newGuestForbidden(errs.EventArchived)
	}
	return nil
}

func ownerMutation(c Ptr[gin.Context], allowArchived bool, mutate func(context.Context, *pgstore.Repository, *pgstore.Event) error) bool {
	var repo = defaultRepository(c)
	if (repo == nil) {
		return false
	}
	var event = loadEvent(c, repo)
	if (event == nil) {
		return false
	}
	var txErr = repo.WithTransaction(c.Request.Context(), (ctx context.Context, tx *pgstore.Repository) => {
		var locked, lockErr = tx.LockEvent(ctx, event.ID)
		if (lockErr != nil) {
			return lockErr
		}
		var authorized, authErr = authorizeOwner(c, tx, locked)
		if (authErr != nil) {
			return authErr
		}
		if (!authorized) {
			return newGuestForbidden(errs.EventOwnerCredentialRequired)
		}
		if (!allowArchived) {
			var writableErr = writableEvent(locked)
			if (writableErr != nil) {
				return writableErr
			}
		}
		return mutate(ctx, tx, locked)
	})
	if (txErr != nil) {
		mutationError(c, txErr)
		return false
	}
	c.Status(http.StatusOK)
	return true
}

// @Summary Archive an event
// @Description Requires the same owner credentials as settings edits; archive makes the event read-only and unarchive restores mutations.
// @Tags events
// @Accept json
// @Produce json
// @Param eventId path string true "Event ID"
// @Param payload body object{archive=bool} true "Archive status"
// @Success 200
// @Failure 403 {object} responses.Error "Owner authority required or event archived"
// @Failure 404 {object} responses.Error "Event not found"
// @Router /events/{eventId}/archive [post]
func archiveEvent(c Ptr[gin.Context]) {
	var input = newArchiveEventInput()
	var bindErr = c.BindJSON(&input)
	if (bindErr != nil) {
		return
	}
	ownerMutation(c, true, (ctx context.Context, tx *pgstore.Repository, event *pgstore.Event) => {
		return tx.SetEventArchived(ctx, event.ID, *input.Archive)
	})
}

// @Summary Deletes an event based on its id
// @Description Requires the same owner credentials as settings edits; deleted events and responses stop resolving.
// @Tags events
// @Produce json
// @Param eventId path string true "Event ID"
// @Success 200
// @Failure 403 {object} responses.Error "Owner authority required or event archived"
// @Failure 404 {object} responses.Error "Event not found"
// @Router /events/{eventId} [delete]
func deleteEvent(c Ptr[gin.Context]) {
	ownerMutation(c, true, (ctx context.Context, tx *pgstore.Repository, event *pgstore.Event) => {
		return tx.SetEventDeleted(ctx, event.ID, true)
	})
}
