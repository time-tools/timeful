package gcloud

import (
	"context"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"os"
	"strconv"
	"strings"
	"time"

	cloudtasks "cloud.google.com/go/cloudtasks/apiv2beta3"
	"cloud.google.com/go/cloudtasks/apiv2beta3/cloudtaskspb"
	"google.golang.org/api/option"
	"google.golang.org/protobuf/types/known/timestamppb"
	"timeful/server/logger"
	"timeful/server/services/listmonk"
	"timeful/server/utils"
)

import "martianoff/gala/go_interop"

var TasksClient *cloudtasks.Client

func EmailTasksParent() string {
	var projectID = strings.TrimSpace(os.Getenv("GOOGLE_CLOUD_PROJECT_ID"))
	if (projectID == "") {
		projectID = "timeful"
	}

	var location = strings.TrimSpace(os.Getenv("GOOGLE_CLOUD_TASKS_LOCATION"))
	if (location == "") {
		location = "us-central1"
	}

	var queue = strings.TrimSpace(os.Getenv("GOOGLE_CLOUD_TASKS_QUEUE"))
	if (queue == "") {
		queue = "SendReminderEmail"
	}

	return fmt.Sprintf("projects/%s/locations/%s/queues/%s", projectID, location, queue)
}

func InitTasks() func() {
	var credsFile = os.Getenv("SERVICE_ACCOUNT_KEY_PATH")
	if (credsFile == "" || credsFile == "?") {
		logger.StdOut.Println("SERVICE_ACCOUNT_KEY_PATH not set, Cloud Tasks disabled")
		return () => {}
	}

	var ctx = context.Background()
	var client, clientErr = cloudtasks.NewClient(ctx, option.WithCredentialsFile(credsFile))
	if (clientErr != nil) {
		logger.StdErr.Println("Failed to initialize Cloud Tasks:", clientErr)
		return () => {}
	}
	TasksClient = client

	// Return function to close client
	return () => {
		FromError(TasksClient.Close())
	}
}

func CreateEmailTask(email string, ownerName string, eventName string, eventId string) []string {
	if (TasksClient == nil) {
		logger.StdErr.Println("WARNING: Cloud Tasks is disabled, skipping CreateEmailTask")
		return go_interop.SliceEmpty[string]()
	}

	// Get listmonk url env vars
	var listmonkUrl = os.Getenv("LISTMONK_URL")
	var listmonkUsername = os.Getenv("LISTMONK_USERNAME")
	var listmonkPassword = os.Getenv("LISTMONK_PASSWORD")
	var basicAuthString = base64.StdEncoding.EncodeToString(go_interop.ToBytes(fmt.Sprintf("%s:%s", listmonkUsername, listmonkPassword)))

	// Find if subscriber exists in listmonk
	var subscriberExists, _ = listmonk.DoesUserExist(email)

	// If subscriber doesn't exist, add subscriber to listmonk
	if (!subscriberExists) {
		listmonk.AddUserToListmonk(email, "", "", "", nil, false)
	}

	// Get email template ids
	var initialEmailReminderId, initialErr = strconv.Atoi(os.Getenv("LISTMONK_INITIAL_EMAIL_REMINDER_ID"))
	if (initialErr != nil) {
		logger.StdErr.Panicln(initialErr)
	}
	var secondEmailReminderId, secondErr = strconv.Atoi(os.Getenv("LISTMONK_SECOND_EMAIL_REMINDER_ID"))
	if (secondErr != nil) {
		logger.StdErr.Panicln(secondErr)
	}
	var finalEmailReminderId, finalErr = strconv.Atoi(os.Getenv("LISTMONK_FINAL_EMAIL_REMINDER_ID"))
	if (finalErr != nil) {
		logger.StdErr.Panicln(finalErr)
	}

	// Create map of emails to iterate through
	var tasksToCreate = go_interop.MapEmpty[int, *timestamppb.Timestamp]()
	tasksToCreate[initialEmailReminderId] = timestamppb.Now()
	tasksToCreate[secondEmailReminderId] = timestamppb.New(time.Now().Add(24 * time.Hour))
	tasksToCreate[finalEmailReminderId] = timestamppb.New(time.Now().Add(3 * 24 * time.Hour))

	// Construct URLs
	var baseUrl = utils.GetBaseUrl()
	var publicEventID = eventId
	var eventUrl = fmt.Sprintf("%s/e/%s", baseUrl, publicEventID)
	var finishedUrl = fmt.Sprintf("%s/e/%s/responded?email=%s", baseUrl, publicEventID, email)

	var taskIds = go_interop.SliceEmpty[string]()

	for templateId, scheduleTime := range tasksToCreate {
		// Create JSON object
		var data = go_interop.MapEmpty[string, any]()
		go_interop.MapPut[string, any](data, "ownerName", ownerName)
		go_interop.MapPut[string, any](data, "eventName", eventName)
		go_interop.MapPut[string, any](data, "eventUrl", eventUrl)
		go_interop.MapPut[string, any](data, "finishedUrl", finishedUrl)
		var payload = go_interop.MapEmpty[string, any]()
		go_interop.MapPut[string, any](payload, "subscriber_email", email)
		go_interop.MapPut[string, any](payload, "template_id", templateId)
		go_interop.MapPut[string, any](payload, "data", data)
		go_interop.MapPut[string, any](payload, "content_type", "html")
		var body, marshalErr = json.Marshal(payload)
		if (marshalErr != nil) {
			logger.StdErr.Panicln(marshalErr)
		}

		var headers = go_interop.MapEmpty[string, string]()
		go_interop.MapPut[string, string](headers, "Authorization", fmt.Sprintf("Basic %s", basicAuthString))
		go_interop.MapPut[string, string](headers, "Content-Type", "application/json")

		// Create task
		var task, taskErr = TasksClient.CreateTask(context.Background(), &cloudtaskspb.CreateTaskRequest{
			Parent: EmailTasksParent(),
			Task: &cloudtaskspb.Task{
				ScheduleTime: scheduleTime,
				PayloadType: &cloudtaskspb.Task_HttpRequest{
					HttpRequest: &cloudtaskspb.HttpRequest{
						Url:        fmt.Sprintf("%s/api/tx", listmonkUrl),
						HttpMethod: cloudtaskspb.HttpMethod_POST,
						Headers:    headers,
						Body:       body,
					},
				},
			},
		})

		if (taskErr != nil) {
			logger.StdErr.Panicln(taskErr)
		}

		taskIds = go_interop.SliceAppend(taskIds, task.Name)
	}

	return taskIds
}

func DeleteEmailTask(taskId string) {
	if (TasksClient == nil) {
		logger.StdErr.Println("WARNING: Cloud Tasks is disabled, skipping DeleteEmailTask")
		return
	}

	var err = TasksClient.DeleteTask(context.Background(), &cloudtaskspb.DeleteTaskRequest{
		Name: taskId,
	})

	if (err != nil) {
		// logger.StdErr.Println(err)
		return
	}
}
