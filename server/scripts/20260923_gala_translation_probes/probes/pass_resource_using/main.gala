package main

import "os"
import . "martianoff/gala/resource"

func main() {
	var f, err = os.Open("go.mod")
	if err != nil {
		return
	}
	val name = Using[*os.File, string](f, (file) => file.Name())
	Println(name.Size() > 0)
	val n = Bracket(41, (x) => { Println("release") }, (x) => x + 1)
	Println(n)
}
